# The OIDF conformance suite release that oid4vci-conformance.yml and
# oid4vp-conformance.yml run, read by both: the release's tag, and the
# commit it must point at (checked after the clone). Its images are
# pinned by digest in suite-pinned.override.yml: move all three together,
# after reviewing the release. The workflows' newer-suite job fails while
# a newer release-v* tag exists.
SUITE_TAG=release-v5.3.5
SUITE_COMMIT=246b2c14b8562012b02d0ac462d667fe49e1a937
